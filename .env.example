# API base URL (defaults to http://<host>:5000/api/v1 if unset — node-api's default dev port)
NEXT_PUBLIC_API_URL=

# Google OAuth 2.0 Client ID (from Google Cloud Console > APIs & Services >
# Credentials). Must match the GOOGLE_CLIENT_ID configured on the backend —
# the backend verifies the ID token's audience against it. Without this set,
# the "Continue with Google" buttons on every login page render nothing.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Cloudflare Turnstile site key (public, safe to expose client-side — this is
# NOT the secret key, which lives only in node-api's backend config). Gates
# the register and forgot-password forms. Without this set, the widget
# renders nothing and those forms submit without a token — matching, and
# gated by, the backend's TURNSTILE_SECRET_KEY requirement.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
